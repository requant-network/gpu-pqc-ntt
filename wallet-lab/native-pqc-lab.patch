 pub fn check_activation(net: &Network, tx: &Tx, height: u64) -> Result<(), Error> {
+    if let Tx::Transfer { inputs, .. } = tx {
+        if inputs.iter().any(|input| matches!(input.unlock, crate::tx::Unlock::MlDsa44(_)))
+            && net.chain_id != crate::pqc::chain_id()
+        {
+            return Err(Error::Invalid("ML-DSA is disabled on this chain"));
+        }
+    }
     if tx.is_v2() && height < net.conditions_height {
         return Err(Error::Invalid("conditions and time locks are not active at this height"));
     }
