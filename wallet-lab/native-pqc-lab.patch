new file mode 100644
index 0000000..231993d
--- /dev/null
+++ b/crates/consensus/tests/pqc_vectors.rs
@@ -0,0 +1,44 @@
+use ml_dsa::{ExpandedSigningKey, Keypair, MlDsa44, Signature, SigningKey, VerifyingKey};
+
+fn bytes(line: &str) -> Vec<u8> {
+    hex::decode(line).unwrap()
+}
+
+#[test]
+#[ignore = "requires PQC_ACVP_TSV prepared from the pinned NIST files"]
+#[allow(deprecated)] // ACVP sigGen supplies an expanded key.
+fn nist_ml_dsa_44() {
+    let vectors = std::fs::read_to_string(std::env::var_os("PQC_ACVP_TSV").unwrap()).unwrap();
+    let mut counts = [0; 4];
+    for line in vectors.lines() {
+        let fields: Vec<_> = line.split('\t').collect();
+        match fields.as_slice() {
+            ["key", id, seed, pk, sk] => {
+                let key = SigningKey::<MlDsa44>::from_seed(&bytes(seed).as_slice().try_into().unwrap());
+                assert_eq!(&key.verifying_key().encode()[..], bytes(pk), "keyGen {id} public");
+                assert_eq!(&key.expanded_key().to_expanded()[..], bytes(sk), "keyGen {id} private");
+                counts[0] += 1;
+            }
+            ["sign", id, sk, message, context, signature] => {
+                let key = ExpandedSigningKey::<MlDsa44>::from_expanded(&bytes(sk).as_slice().try_into().unwrap());
+                let sig = key.sign_deterministic(&bytes(message), &bytes(context)).unwrap();
+                assert_eq!(&sig.encode()[..], bytes(signature), "sigGen {id}");
+                counts[1] += 1;
+            }
+            ["verify", id, pk, message, context, sig, result] => {
+                let pk = VerifyingKey::<MlDsa44>::decode(&bytes(pk).as_slice().try_into().unwrap());
+                let signature = Signature::<MlDsa44>::decode(&bytes(sig).as_slice().try_into().unwrap());
+                let passed = signature
+                    .is_some_and(|signature| pk.verify_with_context(&bytes(message), &bytes(context), &signature));
+                assert_eq!(passed, *result == "true", "sigVer {id}");
+                counts[if passed { 2 } else { 3 }] += 1;
+            }
+            _ => panic!("unrecognized ACVP fixture"),
+        }
+    }
+    assert!(counts.iter().all(|&count| count > 0));
+    println!(
+        "NIST ACVP keyGen={} sigGen={} sigVer_valid={} sigVer_invalid={}",
+        counts[0], counts[1], counts[2], counts[3]
+    );
+}
diff --git a/crates/consensus/tests/pqc_wallet.rs b/crates/consensus/tests/pqc_wallet.rs
new file mode 100644
index 0000000..5ea1939
--- /dev/null
+++ b/crates/consensus/tests/pqc_wallet.rs
@@ -0,0 +1,275 @@
+use ed25519_dalek::SigningKey as EdKey;
+use ml_dsa::{MlDsa44, Seed, SigningKey};
+use requant_consensus::address::{bech32m_decode, bech32m_encode, parse_address};
+use requant_consensus::block::Block;
+use requant_consensus::chain::{mine, Chain};
+use requant_consensus::params::Network;
+use requant_consensus::pqc;
+use requant_consensus::tx::{pkh, Hash, Input, OutPoint, Output, Tx, Unlock};
+use requant_consensus::Error;
+use std::{hint::black_box, time::Instant};
+use zeroize::Zeroizing;
+
+const NOW: u64 = u64::MAX / 2;
+const FEE: u64 = 1000;
+
+fn block(chain: &mut Chain, payee: &Hash, txs: Vec<Tx>) -> Block {
+    let tip = chain.tip();
+    let height = chain.height() + 1;
+    let mut block = chain.template_on(&tip, payee, txs, chain.net.genesis_time + 60 * height);
+    let seed = chain.epoch_seed(&tip, height);
+    let epoch = chain.epoch(&seed);
+    block.claim = mine(&chain.net, &epoch, &block.header, 0, 1000).unwrap();
+    block
+}
+
+fn extend(chain: &mut Chain, payee: &Hash, txs: Vec<Tx>) {
+    let block = block(chain, payee, txs);
+    chain.accept(block, NOW).unwrap();
+}
+
+fn legacy(chain_id: &Hash, key: &EdKey, prev: OutPoint, outputs: Vec<Output>) -> Tx {
+    let mut tx = Tx::Transfer {
+        inputs: vec![Input::new(prev)],
+        outputs,
+    };
+    tx.sign(chain_id, &[key]);
+    tx
+}
+
+fn sign(key: &SigningKey<MlDsa44>, prev: OutPoint, outputs: Vec<Output>) -> Tx {
+    let mut tx = Tx::Transfer {
+        inputs: vec![pqc::input(prev, key)],
+        outputs,
+    };
+    pqc::sign(&mut tx, 0, key).unwrap();
+    tx
+}
+
+fn restore(backup: &[u8]) -> Result<SigningKey<MlDsa44>, &'static str> {
+    let [1, bytes @ ..] = backup else {
+        return Err("unknown backup version");
+    };
+    let seed = Zeroizing::new(Seed::try_from(bytes).map_err(|_| "invalid seed size")?);
+    Ok(SigningKey::from_seed(&seed))
+}
+
+fn validate(chain: &Chain, wire: &[u8]) -> Result<u64, Error> {
+    let tx = Tx::decode_exact(wire)?;
+    tx.check_standalone(&chain.net.chain_id)?;
+    chain.check_spend(&tx)
+}
+
+fn inputs(tx: &mut Tx) -> &mut Vec<Input> {
+    let Tx::Transfer { inputs, .. } = tx else {
+        unreachable!()
+    };
+    inputs
+}
+
+#[test]
+fn restored_wallet_spends_after_legacy_migration() {
+    let mut backup = Zeroizing::new([0u8; 33]);
+    backup[0] = 1;
+    getrandom::fill(&mut backup[1..]).unwrap();
+    assert!(restore(&[2; 33]).is_err());
+    assert!(restore(&backup[..32]).is_err());
+
+    let legacy_key = EdKey::from_bytes(&[1; 32]);
+    let legacy_owner = pkh(&legacy_key.verifying_key().to_bytes());
+    let mut chain = Chain::new(Network::pqc_lab(), 1);
+    assert!(Network::by_name(chain.net.name).is_none());
+    let genesis = chain.tip();
+    assert_ne!(genesis, Chain::new(Network::regtest(), 1).tip());
+    let chain_id = chain.net.chain_id;
+    let first = block(&mut chain, &legacy_owner, vec![]);
+    let coin = OutPoint {
+        txid: first.txs[0].txid(),
+        vout: 0,
+    };
+    chain.accept(first, NOW).unwrap();
+    for _ in 0..chain.net.maturity {
+        extend(&mut chain, &legacy_owner, vec![]);
+    }
+
+    let original_key = restore(&backup[..]).unwrap();
+    let address = pqc::address(&original_key);
+    let pq_owner = pqc::parse_address(&address).unwrap();
+    assert!(parse_address(&Network::regtest(), &address).is_err());
+    assert!(parse_address(&chain.net, &address).is_err());
+    let legacy_address = requant_consensus::address::address(&chain.net, &legacy_owner);
+    assert_eq!(parse_address(&chain.net, &legacy_address).unwrap(), legacy_owner);
+    assert!(pqc::parse_address(&legacy_address).is_err());
+    let (prefix, mut data) = bech32m_decode(&address).unwrap();
+    data[0] = 2;
+    assert!(pqc::parse_address(&bech32m_encode(&prefix, &data)).is_err());
+
+    let value = chain.coin(&coin).unwrap().output.value;
+    let half = (value - FEE) / 2;
+    let migration = legacy(
+        &chain_id,
+        &legacy_key,
+        coin,
+        vec![
+            Output {
+                value: half,
+                pkh: pq_owner,
+            },
+            Output {
+                value: value - FEE - half,
+                pkh: legacy_owner,
+            },
+        ],
+    );
+    let pq_coin = OutPoint {
+        txid: migration.txid(),
+        vout: 0,
+    };
+    let ed_coin = OutPoint {
+        txid: migration.txid(),
+        vout: 1,
+    };
+    extend(&mut chain, &legacy_owner, vec![migration]);
+    assert_eq!(chain.coin(&pq_coin).unwrap().output.pkh, pq_owner);
+    let outputs = vec![Output {
+        value: half - FEE,
+        pkh: legacy_owner,
+    }];
+    let signed = sign(&original_key, pq_coin, outputs.clone()).encode();
+    drop(original_key);
+
+    let key = restore(&backup[..]).unwrap();
+    assert_eq!(pqc::address(&key), address);
+    let good = sign(&key, pq_coin, outputs.clone());
+    assert_eq!(good.encode(), signed);
+    assert_eq!(validate(&chain, &signed), Ok(FEE));
+    assert_eq!(
+        good.check_standalone(&Network::test().chain_id),
+        Err(Error::Invalid("ML-DSA is disabled on this chain"))
+    );
+    assert_eq!(
+        good.check_standalone(&Network::regtest().chain_id),
+        Err(Error::Invalid("ML-DSA is disabled on this chain"))
+    );
+
+    let mut changed_output = good.clone();
+    let Tx::Transfer { outputs: changed, .. } = &mut changed_output else {
+        unreachable!()
+    };
+    changed[0].value -= 1;
+    let invalid_block = block(&mut chain, &legacy_owner, vec![changed_output]);
+    assert_eq!(
+        chain.accept(invalid_block, NOW),
+        Err(Error::Invalid("bad ML-DSA signature"))
+    );
+    assert!(chain.coin(&pq_coin).is_some());
+
+    let mut changed_signature = good.clone();
+    let Unlock::MlDsa44(witness) = &mut inputs(&mut changed_signature)[0].unlock else {
+        unreachable!()
+    };
+    witness.signature[0] ^= 1;
+    assert_eq!(changed_signature.txid(), good.txid());
+    assert_ne!(changed_signature.wtxid(), good.wtxid());
+    assert!(validate(&chain, &changed_signature.encode()).is_err());
+    let mut changed_padding = good.clone();
+    inputs(&mut changed_padding)[0].sig[0] = 1;
+    assert_eq!(
+        validate(&chain, &changed_padding.encode()),
+        Err(Error::Invalid("noncanonical ML-DSA input"))
+    );
+
+    let mut unknown = signed.clone();
+    // v1 header + kind + count + outpoint + reserved Ed25519 slots + v2 locks.
+    let tag = 4 + 1 + 1 + 36 + 96 + 12;
+    assert_eq!(unknown[tag], 9);
+    unknown[tag] = 10;
+    assert_eq!(Tx::decode_exact(&unknown), Err(Error::Decode("unlock kind")));
+    unknown[tag] = 9 | 0x80;
+    assert_eq!(
+        validate(&chain, &unknown),
+        Err(Error::Invalid("noncanonical ML-DSA input"))
+    );
+    let mut unsupported = signed.clone();
+    unsupported[0] = 99;
+    assert_eq!(Tx::decode_exact(&unsupported), Err(Error::Decode("tx version")));
+    assert!(Tx::decode_exact(&signed[..signed.len() - 1]).is_err());
+
+    let wrong_owner = legacy(&chain_id, &legacy_key, pq_coin, outputs.clone());
+    assert_eq!(
+        validate(&chain, &wrong_owner.encode()),
+        Err(Error::Invalid("input key does not match the output"))
+    );
+    let mut wrong_backup = Zeroizing::new(*backup);
+    wrong_backup[32] ^= 1;
+    let wrong_key = restore(&wrong_backup[..]).unwrap();
+    let wrong_owner = sign(&wrong_key, pq_coin, outputs.clone());
+    assert_eq!(
+        validate(&chain, &wrong_owner.encode()),
+        Err(Error::Invalid("input key does not match the output"))
+    );
+
+    let ed = legacy(&chain_id, &legacy_key, ed_coin, outputs.clone());
+    assert_eq!(validate(&chain, &ed.encode()), Ok(value - FEE - 2 * half + FEE));
+    println!(
+        "native_size_bytes ed25519={} ml_dsa_44={}",
+        ed.encode().len(),
+        signed.len()
+    );
+    if std::env::var_os("PQC_BENCH").is_some() {
+        bench("ed25519", &chain, |i| {
+            legacy(
+                &chain_id,
+                &legacy_key,
+                ed_coin,
+                vec![Output {
+                    value: half - FEE - i,
+                    pkh: legacy_owner,
+                }],
+            )
+        });
+        bench("ml_dsa_44", &chain, |i| {
+            sign(
+                &key,
+                pq_coin,
+                vec![Output {
+                    value: half - FEE - i,
+                    pkh: legacy_owner,
+                }],
+            )
+        });
+    }
+    let recovered = Tx::decode_exact(&signed).unwrap();
+    let paid = OutPoint {
+        txid: recovered.txid(),
+        vout: 0,
+    };
+    extend(&mut chain, &legacy_owner, vec![ed, recovered]);
+    assert!(chain.coin(&pq_coin).is_none());
+    assert!(chain.coin(&ed_coin).is_none());
+    assert_eq!(chain.coin(&paid).unwrap().output, outputs[0]);
+    assert_eq!(validate(&chain, &signed), Err(Error::Invalid("missing or spent input")));
+    println!("native_migration=accepted restored_spend=accepted same_block_legacy=accepted negative_controls=18");
+}
+
+fn bench(name: &str, chain: &Chain, sign: impl Fn(u64) -> Tx) {
+    const N: u64 = 128;
+    for trial in 0..5 {
+        let mut wires = Vec::with_capacity(N as usize);
+        let start = Instant::now();
+        for i in 0..N {
+            wires.push(black_box(sign(trial * N + i).encode()));
+        }
+        let sign_elapsed = start.elapsed().as_secs_f64();
+        let start = Instant::now();
+        for wire in &wires {
+            black_box(validate(chain, black_box(wire)).unwrap());
+        }
+        let verify_elapsed = start.elapsed().as_secs_f64();
+        println!(
+            "bench scheme={name} trial={trial} n={N} sign_encode_us={:.3} decode_validate_us={:.3}",
+            sign_elapsed * 1e6 / N as f64,
+            verify_elapsed * 1e6 / N as f64
+        );
+    }
+}
