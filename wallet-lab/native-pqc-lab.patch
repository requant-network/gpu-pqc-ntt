index 0000000..18ed155
--- /dev/null
+++ b/crates/consensus/src/pqc.rs
@@ -0,0 +1,82 @@
+//! Isolated wallet research. No named-node network enables this spending condition.
+
+use crate::address::{bech32m_decode, bech32m_encode, convert_bits};
+use crate::params::tagged;
+use crate::tx::{Hash, Input, OutPoint, Tx, Unlock};
+use crate::Error;
+use ml_dsa::{Keypair, MlDsa44, Signature, SigningKey, VerifyingKey};
+
+const CONTEXT: &[u8] = b"requant/pqc-lab/tx/v1";
+const ADDRESS_PREFIX: &str = "rqpl";
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct Witness {
+    pub public: [u8; 1312],
+    pub signature: [u8; 2420],
+}
+
+pub(crate) fn chain_id() -> Hash {
+    tagged("requant/chain", &[b"pqc-lab"])
+}
+
+pub fn owner(public: &[u8; 1312]) -> Hash {
+    tagged("requant/pqc-lab/ml-dsa-44/v1", &[public])
+}
+
+pub fn address(key: &SigningKey<MlDsa44>) -> String {
+    let hash = owner(&key.verifying_key().encode().into());
+    let mut data = vec![1];
+    data.extend(convert_bits(&hash, 8, 5, true).unwrap());
+    bech32m_encode(ADDRESS_PREFIX, &data)
+}
+
+pub fn parse_address(address: &str) -> Result<Hash, &'static str> {
+    let (prefix, data) = bech32m_decode(address)?;
+    if prefix != ADDRESS_PREFIX || data.first() != Some(&1) {
+        return Err("unknown ML-DSA address network or version");
+    }
+    convert_bits(&data[1..], 5, 8, false)
+        .and_then(|bytes| bytes.try_into().ok())
+        .ok_or("invalid ML-DSA address")
+}
+
+pub fn input(prev: OutPoint, key: &SigningKey<MlDsa44>) -> Input {
+    let witness = Witness {
+        public: key.verifying_key().encode().into(),
+        signature: [0; 2420],
+    };
+    Input {
+        unlock: Unlock::MlDsa44(Box::new(witness)),
+        ..Input::new(prev)
+    }
+}
+
+pub fn sign(tx: &mut Tx, index: usize, key: &SigningKey<MlDsa44>) -> Result<(), Error> {
+    let sighash = Tx::sighash(&chain_id(), &tx.txid(), index as u32);
+    let Tx::Transfer { inputs, .. } = tx else {
+        return Err(Error::Invalid("not a transfer"));
+    };
+    let Some(Unlock::MlDsa44(witness)) = inputs.get_mut(index).map(|input| &mut input.unlock) else {
+        return Err(Error::Invalid("missing ML-DSA input"));
+    };
+    if witness.public != <[u8; 1312]>::from(key.verifying_key().encode()) {
+        return Err(Error::Invalid("wrong ML-DSA signing key"));
+    }
+    witness.signature = key
+        .expanded_key()
+        .sign_deterministic(&sighash, CONTEXT)
+        .map_err(|_| Error::Invalid("ML-DSA signing failed"))?
+        .encode()
+        .into();
+    Ok(())
+}
+
+pub(crate) fn verify(witness: &Witness, sighash: &Hash) -> Result<(), Error> {
+    let public = VerifyingKey::<MlDsa44>::decode(&witness.public.into());
+    let signature = Signature::<MlDsa44>::decode(&witness.signature.into())
+        .ok_or(Error::Invalid("bad ML-DSA signature encoding"))?;
+    if !public.verify_with_context(sighash, CONTEXT, &signature) {
+        return Err(Error::Invalid("bad ML-DSA signature"));
+    }
+    Ok(())
+}
